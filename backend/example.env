# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Flask Server Configuration
# Port for the Flask server to run on (default: 8080)
PORT=8080

# MongoDB Atlas Configuration (required for database)
# Get your connection string from: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/?retryWrites=true&w=majority

# Google Cloud Configuration
# Your Google Cloud Project ID (required for Virtual Try-On)
# Get this from: https://console.cloud.google.com/
GOOGLE_CLOUD_PROJECT=your-project-id-here
GOOGLE_API_KEY=Your google API Key

# Google Cloud Region (default: us-central1)
# Options: us-central1, us-east1, us-west1, europe-west1, asia-east1, etc.
GOOGLE_CLOUD_REGION=us-central1

# Google Cloud Credentials (optional - only if using service account key file)
# If not set, will use Application Default Credentials (gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# Note: Make sure you have:
# 1. Enabled the Vertex AI API in your Google Cloud project
# 2. Set up authentication (Application Default Credentials or service account)
# 3. Enabled billing for your project (Virtual Try-On requires billing)

# Gumloop Configuration (for multi-view generation alternative)
# Only needed if USE_GUMLOOP=True in generate_views.py
GUMLOOP_API_KEY=your-gumloop-api-key
GUMLOOP_USER_ID=your-gumloop-user-id
GUMLOOP_FLOW_ID=your-gumloop-flow-id

# Cloudinary Configuration (required for Gumloop)
# Only needed if USE_GUMLOOP=True in generate_views.py
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@name