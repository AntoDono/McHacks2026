# Chrome Extension Environment Variables
# Copy this file to .env and fill in your actual values
# Note: Plasmo uses PLASMO_PUBLIC_ prefix for public environment variables

# Backend API Configuration
# Full API URL (optional - if not set, will use localhost with PLASMO_PUBLIC_PORT)
# Example: http://localhost:8080 or https://your-backend-domain.com
PLASMO_PUBLIC_API_URL=http://localhost:8080

# Backend API Port (optional - only used if PLASMO_PUBLIC_API_URL is not set)
# Default: 8080
PLASMO_PUBLIC_PORT=8080

# Note: 
# - These variables are public and will be bundled with your extension
# - Do not put sensitive credentials here
# - For production, set PLASMO_PUBLIC_API_URL to your deployed backend URL
